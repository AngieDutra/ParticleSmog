#N canvas 0 0 760 640 12;
#X obj 40 40 adc~ 1;
#X obj 40 110 env~;
#X obj 40 150 + 60;
#X obj 40 180 / 60;
#X obj 40 210 clip 0 1;
#X msg 40 250 send volume \$1;
#X obj 320 40 fiddle~ 1024;
#X obj 320 90 mtof;
#X obj 320 130 clip 20 4000;
#X msg 320 170 send pitch \$1;
#X obj 40 430 netsend -u;
#X msg 40 390 connect localhost 12000;
#X obj 40 310 loadbang;
#X obj 40 350 del 500;
#X text 40 10 NOISE POLLUTION -- audio analysis (Pd);
#X text 40 480 1. Turn on DSP (ctrl or cmd plus slash) before use.;
#X text 40 500 2. Uses only vanilla Pd objects -- no externals required.;
#X text 40 520 3. Sends volume and pitch as plain UDP text messages to localhost port 12000.;
#X text 320 210 fiddle~ outputs raw pitch continuously in MIDI units;
#X text 320 230 from its left outlet -- mtof converts that to Hz.;
#X text 320 250 Pitch tracking is noisy on broadband non-tonal sounds;
#X text 320 270 such as traffic or wind -- that is expected for real;
#X text 320 290 environmental noise, not a bug.;
#X text 40 550 netsend in UDP mode sends each message as plain text;
#X text 40 570 the Processing sketch parses it directly, no OSC library needed.;
#X connect 0 0 1 0;
#X connect 0 0 6 0;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 10 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 9 0 10 0;
#X connect 12 0 13 0;
#X connect 13 0 11 0;
#X connect 11 0 10 0;
